# Exemplos locais; não use essas credenciais em produção.
HTTP_ADDR=:8080
DATABASE_URL=postgres://jungle:jungle-local@localhost:5432/jungle?sslmode=disable
LOG_LEVEL=INFO
DEPENDENCY_TIMEOUT=3s
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_ENDPOINT=http://localhost:4566
SQS_QUEUE_NAME=wager-transactions.fifo
SQS_CONSUMER_NAME=financial-operations-v1
SQS_CONSUMER_CONCURRENCY=2
SQS_CONSUMER_BATCH_SIZE=1
SQS_CONSUMER_WAIT_SECONDS=20
SQS_VISIBILITY_SECONDS=30
SQS_PROCESS_TIMEOUT=5s
SQS_EVENTS_QUEUE_NAME=wager-events.fifo
OUTBOX_BATCH_SIZE=10
OUTBOX_POLL_INTERVAL=1s
OUTBOX_LEASE=30s
OUTBOX_RETRY_BASE=1s
OUTBOX_RETRY_MAX=1m
REFERENCE_BATCH_SIZE=5
REFERENCE_POLL_INTERVAL=1s
REFERENCE_LEASE=30s
REFERENCE_PROCESS_TIMEOUT=5s
REFERENCE_RETRY_BASE=5s
REFERENCE_RETRY_MAX=5m
REFERENCE_MAX_ATTEMPTS=10
