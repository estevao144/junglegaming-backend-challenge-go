{
  "realm": "jungle",
  "enabled": true,
  "roles": {
    "realm": [
      {"name": "provider"},
      {"name": "wallet-internal"}
    ]
  },
  "clients": [
    {
      "clientId": "provider-a",
      "secret": "provider-a-local",
      "protocol": "openid-connect",
      "publicClient": false,
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "protocolMappers": [
        {
          "name": "provider-id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "config": {"claim.name": "providerId", "claim.value": "provider-a", "jsonType.label": "String", "access.token.claim": "true"}
        },
        {
          "name": "api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {"included.custom.audience": "jungle-api", "access.token.claim": "true"}
        }
      ]
    },
    {
      "clientId": "wallet-internal",
      "secret": "wallet-internal-local",
      "protocol": "openid-connect",
      "publicClient": false,
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "protocolMappers": [
        {
          "name": "api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {"included.custom.audience": "jungle-api", "access.token.claim": "true"}
        }
      ]
    }
  ],
  "users": [
    {"username": "service-account-provider-a", "enabled": true, "serviceAccountClientId": "provider-a", "realmRoles": ["provider"]},
    {"username": "service-account-wallet-internal", "enabled": true, "serviceAccountClientId": "wallet-internal", "realmRoles": ["wallet-internal"]}
  ]
}
